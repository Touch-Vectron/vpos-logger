{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "address": "127.0.0.1:33284",
      "name": "attach",
      "request": "attach",
      "stopOnEntry": true,
      "type": "lua"
    },
    {
      "name": "attach process",
      "processId": "${command:pickProcess}",
      "request": "attach",
      "stopOnEntry": true,
      "type": "lua"
    },

    {
      "type": "emmylua_attach",
      "request": "attach",
      "name": "Attach by process id",
      "pid": 0,
      "ext": [
        ".lua",
        ".lua.txt",
        ".lua.bytes",
        ".vsp",
        ".vsc"
      ]
    },
    {
      "type": "emmylua_new",
      "request": "launch",
      "name": "EmmyLua New Debug",
      "host": "localhost",
      "port": 9966,
      "ext": [
        ".lua",
        ".lua.txt",
        ".lua.bytes",
        ".vsp",
        ".vsc"
      ],
      "ideConnectDebugger": true
    }
  ]
}