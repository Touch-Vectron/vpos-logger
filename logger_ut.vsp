      expIsoDate = "2034-10-29T00:00:00.0000+02:00",
    },
  }

  for i, v in ipairs(variations) do
    local gotIsoDate = dateISO(v.date)
    if gotIsoDate ~= v.expIsoDate then
      Log.log(logLevel.Error, true,
        "Test %d failed. Expected: %s <> Got: %s",
        i, v.expIsoDate, tostring(gotIsoDate))
    end
