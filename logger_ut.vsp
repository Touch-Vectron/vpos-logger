--#region Global constants and enums **********

--- Logging level.
local logLevel = {
  Off   = "off",
  Error = "error",
  Warn  = "warn",
  Info  = "info",
  Debug = "debug",
  Trace = "trace",
}

--- Syslog Protocol priority (RFC-5424).
local Priority = {
  USER_ERROR = 11,
  USER_WARN  = 12,
  USER_INFO  = 14,
  USER_DEBUG = 15,
}

--- Logging type/mode.
local LogType = {
  OFFLINE = "offline",
  ONLINE  = "online",
}

--- Minimum log level for logging a line/message.
LOG_LEVEL = logLevel.Info

--- Switch to online or offline/local logs.
LOG_TYPE = LogType.OFFLINE

--- Maximum log file size in kilobytes before rollover.
LOG_SIZE = 300

--- Maximum log line/message size in bytes after which is it truncated, if not doing
--- a full send; truncation is the default behavior.
LOG_TRUNCATE_SIZE = 1000

--- URL where logs are shown on Papertrail.
URL_PAPERTRAIL = "http://logs6.papertrailapp.com:17732"

--- ISO 8601 date constants.
local IsoDate = {
  DATE_SEP      = "-", --- Separator between date parts.
  TIME_MARK     = "T", --- Time mark/sign between the date and time sections.
  TIME_SEP      = ":", --- Separator between the time parts and respectively time zone parts.
  TZ_UTC_MARK   = "Z", --- Time zone UTC mark/sign.
  TZ_PLUS_MARK  = "+", --- Time zone plus mark/sign.
  TZ_MINUS_MARK = "-", --- Time zone minus mark/sign.
}
IsoDate.BYTE_DATE_SEP      = IsoDate.DATE_SEP:byte(1)
IsoDate.BYTE_TIME_MARK     = IsoDate.TIME_MARK:byte(1)
IsoDate.BYTE_TIME_SEP      = IsoDate.TIME_SEP:byte(1)
IsoDate.BYTE_TZ_UTC_MARK   = IsoDate.TZ_UTC_MARK:byte(1)
IsoDate.BYTE_TZ_PLUS_MARK  = IsoDate.TZ_PLUS_MARK:byte(1)
IsoDate.BYTE_TZ_MINUS_MARK = IsoDate.TZ_MINUS_MARK:byte(1)

--#endregion **********


--#region Global variables **********

--- The logger object.
Log = {}

--#endregion **********


--#region Helper functions **********

assertAndOrLog = function(condition, errMsg) assert(condition, errMsg) end

--- Formats the given or current date according to the ISO 8601 (long) format
--- `yyyy-mm-ddThh:mm:ss±hh:mm`. Currently, `yyyy-mm-ddThh:mm:ss` is returned
--- (only the first 19 out of the 25 characters).<br/>
--- Example of returned date: `2016-11-09T04:25:28` (the full date could be
--- `2016-11-09T04:25:28+01:00`).
---@diagnostic disable-next-line: undefined-doc-name
---@param date vpos.datetime.DateTime? Date to be formatted; defaults to the current date if `nil`
---@return string # The formatted given or current date
local function dateISO(date)
  date = date or vpos.datetime.DateTime()
---@diagnostic disable: undefined-field
  local day, month, year = date:getDate()
  local hour, minute, second = date:getTime()
---@diagnostic enable: undefined-field

  return string.format("%s-%02d-%02dT%02d:%02d:%02d",
                       tostring(year), month, day, hour, minute, second)
end

--- Decomposes the given date in ISO 8601 (long) format `yyyy-mm-ddThh:mm:ss±hh:mm` (length
--- 25).<br/>
--- NOTE: The minimum accepted ISO date is `yyyy-mm-ddThh:mm:ss` (length 19); also accepted
--- is `yyyy-mm-ddThh:mm:ssZ` (UTC length 20) and `yyyy-mm-ddThh:mm:ss±hh` (length 22).<br/>
---Raises an error if the string is not an ISO 8601 date or a date part can't be converted.
---@param isoDate string The date in ISO 8601 format
---@return table # A table with all of the ISO date parts:
---   * `year`, `month`, `day` integer
---   * `hours`, `minute`, `second` integer
---   * `timezoneHour`, `timezoneMinute` integer 
local function decomposeIsoDate(isoDate)
  assertAndOrLog(isoDate)

  -- ISO 8601: y y y y - m m - d d T h h : m m : s s ± h h : m m
  -- Position: 1       5     8     11    14    17    20    23  25

  local dateLen = string.len(isoDate)
  if dateLen < 19 then
    error("String is too short to be an ISO 8601 date or is incomplete (down to seconds required)")
  elseif dateLen > 25 then
    error("String is too long to be an ISO 8601 date")
  elseif dateLen == 21 or dateLen == 23 or dateLen == 24 then
    error("String length is invalid to be an ISO 8601 date")
  end
  if string.byte(isoDate, 5)  ~= IsoDate.BYTE_DATE_SEP                        or
     string.byte(isoDate, 8)  ~= IsoDate.BYTE_DATE_SEP                        or
     string.byte(isoDate, 11) ~= IsoDate.BYTE_TIME_MARK                       or
     string.byte(isoDate, 14) ~= IsoDate.BYTE_TIME_SEP                        or
     string.byte(isoDate, 17) ~= IsoDate.BYTE_TIME_SEP                        or
     (dateLen == 20 and string.byte(isoDate, 20) ~= IsoDate.BYTE_TZ_UTC_MARK) or
     ((dateLen == 22 or dateLen == 25) and
      (string.byte(isoDate, 20) ~= IsoDate.BYTE_TZ_PLUS_MARK and
       string.byte(isoDate, 20) ~= IsoDate.BYTE_TZ_MINUS_MARK))               or
     (dateLen == 25 and
      ((string.byte(isoDate, 20) ~= IsoDate.BYTE_TZ_PLUS_MARK and
        string.byte(isoDate, 20) ~= IsoDate.BYTE_TZ_MINUS_MARK) or
       string.byte(isoDate, 23) ~= IsoDate.BYTE_TIME_SEP)) then
    error("String is not an ISO 8601 date")
  end

  local year = tonumber(string.sub(isoDate, 1, 4))
  if not year then error("Can't convert year to number") end
  local month = tonumber(string.sub(isoDate, 6, 7))
  if not month then error("Can't convert month to number") end
  local day = tonumber(string.sub(isoDate, 9, 10))
  if not day then error("Can't convert day to number") end

  local hour = tonumber(string.sub(isoDate, 12, 13))
  if not hour then error("Can't convert hour to number") end
  local minute = tonumber(string.sub(isoDate, 15, 16))
  if not minute then error("Can't convert minute to number") end
  local second = tonumber(string.sub(isoDate, 18, 19))
  if not second then error("Can't convert second to number") end

  local timezoneHour = 0 ---@type number?
  if dateLen == 22 or dateLen == 25 then
    timezoneHour = tonumber(string.sub(isoDate, 20, 22))
    if not timezoneHour then error("Can't convert time zone hour to number") end
  end
  local timezoneMinute = 0 ---@type number?
  if dateLen == 25 then
    timezoneMinute = tonumber(string.sub(isoDate, 24, 25))
    if not timezoneMinute then error("Can't convert time zone minute to number") end
  end

  return {
    year = year, month = month, day = day, hour = hour, minute = minute, second = second,
    timezoneHour = timezoneHour, timezoneMinute = timezoneMinute,
  }
end

--#endregion **********

--#region Helper TESTS **********

local function test_decomposeIsoDate_InvalidIsoDateVariations_Errors()
  local invalidVariations = {
    [1] = {
      isoDate   = "",
      expErrMsg = "String is too short to be an ISO 8601 date or is incomplete (down to seconds required)",
    },
    [2] = {
      isoDate   = "bla bla",
      expErrMsg = "String is too short to be an ISO 8601 date or is incomplete (down to seconds required)",
    },
    [3] = {
      isoDate   = "2024-01-02T12:40",
      expErrMsg = "String is too short to be an ISO 8601 date or is incomplete (down to seconds required)",
    },
    [4] = {
      isoDate   = "2024-01-03T13:41:52+01:00a",
      expErrMsg = "String is too long to be an ISO 8601 date",
    },
    [5] = {
      isoDate  = "2024-01-04T14:41:52+2",
      expErrMsg = "String length is invalid to be an ISO 8601 date",
    },
    [6] = {
      isoDate   = "2024-01-04T14:41:52+02:",
      expErrMsg = "String length is invalid to be an ISO 8601 date",
    },
    [7] = {
      isoDate   = "2024-01-04T14:41:52+02:0",
      expErrMsg = "String length is invalid to be an ISO 8601 date",
    },
    [8] = {
      isoDate   = "2024/01-05T15:43:54",
      expErrMsg = "String is not an ISO 8601 date",
    },
    [9] = {
      isoDate   = "2024-01.05T15:43:54",
      expErrMsg = "String is not an ISO 8601 date",
    },
    [10] = {
      isoDate   = "2024-01-05t15:43:54",
      expErrMsg = "String is not an ISO 8601 date",
    },
    [11] = {
      isoDate   = "2024-01-05T15-43:54",
      expErrMsg = "String is not an ISO 8601 date",
    },
    [12] = {
      isoDate   = "2024-01-05T15:43.54",
      expErrMsg = "String is not an ISO 8601 date",
    },
    [13] = {
      isoDate   = "2024-01-05T15:43:54z",
      expErrMsg = "String is not an ISO 8601 date",
    },
    [14] = {
      isoDate   = "2024-01-05T15:43:54/03:00",
      expErrMsg = "String is not an ISO 8601 date",
    },
    [15] = {
      isoDate   = "2024-01-05T15:43:54+03.00",
      expErrMsg = "String is not an ISO 8601 date",
    },
    [16] = {
      isoDate   = "a024-01-06T16:44:55",
      expErrMsg = "Can't convert year to number",
    },
    [17] = {
      isoDate   = "202b-01-06T16:44:55Z",
      expErrMsg = "Can't convert year to number",
    },
    [18] = {
      isoDate   = "2024-c1-06T16:44:55-04:30",
      expErrMsg = "Can't convert month to number",
    },
    [19] = {
      isoDate   = "2024-0d-06T16:44:55",
      expErrMsg = "Can't convert month to number",
    },
    [20] = {
      isoDate   = "2024-01-e6T16:44:55-04",
      expErrMsg = "Can't convert day to number",
    },
    [21] = {
      isoDate   = "2024-01-0fT16:44:55-04:30",
      expErrMsg = "Can't convert day to number",
    },
    [22] = {
      isoDate   = "2024-01-06Tg6:44:55",
      expErrMsg = "Can't convert hour to number",
    },
    [23] = {
      isoDate   = "2024-01-06T1h:44:55Z",
      expErrMsg = "Can't convert hour to number",
    },
    [24] = {
      isoDate   = "2024-01-06T16:i4:55-04:30",
      expErrMsg = "Can't convert minute to number",
    },
    [25] = {
      isoDate   = "2024-01-06T16:4j:55",
      expErrMsg = "Can't convert minute to number",
    },
    [26] = {
      isoDate   = "2024-01-06T16:44:k5-04",
      expErrMsg = "Can't convert second to number",
    },
    [27] = {
      isoDate   = "2024-01-06T16:44:5m-04:30",
      expErrMsg = "Can't convert second to number",
    },
    [28] = {
      isoDate   = "2024-01-06T16:44:55-n4",
      expErrMsg = "Can't convert time zone hour to number",
    },
    [29] = {
      isoDate   = "2024-01-06T16:44:55-0p:30",
      expErrMsg = "Can't convert time zone hour to number",
    },
    [30] = {
      isoDate   = "2024-01-06T16:44:55-04:3q",
      expErrMsg = "Can't convert time zone minute to number",
    },
  }

  for i, v in ipairs(invalidVariations) do
    local ok, decDate = pcall(decomposeIsoDate, v.isoDate) -- the decomposed date
    if not ok then -- `decDate` is `pcall`s error message here
      local decDateStr = tostring(decDate)
      local errMsg = decDateStr:match(":%d*: (.*)$") or decDateStr
      if errMsg ~= v.expErrMsg then
        Log.warnEx(
          "Test %d partially failed. Expected error: %s <> Got error: %s",
          i, tostring(v.expErrMsg), tostring(errMsg))
      end
    elseif not decDate then
      Log.errorEx(
        "Test %d failed. Expected error: %s <> Got: nil",
        i, tostring(v.expErrMsg))
    elseif decDate.year         or decDate.month          or decDate.day    or
           decDate.hour         or decDate.minute         or decDate.second or
           decDate.timezoneHour or decDate.timezoneMinute then
      Log.errorEx(
        "Test %d failed. Expected error: %s <> Got yMd Hms tzHm: %s %s %s %s %s %s %s %s",
        i, tostring(v.expErrMsg),
        tostring(decDate.year),         tostring(decDate.month),        tostring(decDate.day),
        tostring(decDate.hour),         tostring(decDate.minute),       tostring(decDate.second),
        tostring(decDate.timezoneHour), tostring(decDate.timezoneMinute))
    end
  end
end

local function test_decomposeIsoDate_ValidIsoDateVariations_IsoDateParts()
  local validVariations = {
    [1] = {
      isoDate    = "2024-01-02T12:40:51",
      expDecDate = {y=2024, mo=1, d=2, h=12, min=40, s=51, tzH=0, tzMin=0},
    },
    [2] = {
      isoDate    = "2024-01-05T15:43:54Z",
      expDecDate = {y=2024, mo=1, d=5, h=15, min=43, s=54, tzH=0, tzMin=0},
    },
    [3] = {
      isoDate    = "2024-01-05T15:43:54+03",
      expDecDate = {y=2024, mo=1, d=5, h=15, min=43, s=54, tzH=3, tzMin=0},
    },
    [4] = {
      isoDate    = "2024-01-05T15:43:54-03",
      expDecDate = {y=2024, mo=1, d=5, h=15, min=43, s=54, tzH=-3, tzMin=0},
    },
    [5] = {
      isoDate    = "2024-01-05T15:43:54+03:00",
      expDecDate = {y=2024, mo=1, d=5, h=15, min=43, s=54, tzH=3, tzMin=0},
    },
    [6] = {
      isoDate    = "2024-01-05T15:43:54-03:00",
      expDecDate = {y=2024, mo=1, d=5, h=15, min=43, s=54, tzH=-3, tzMin=0},
    },
    [7] = {
      isoDate    = "2024-01-05T15:43:54+04:30",
      expDecDate = {y=2024, mo=1, d=5, h=15, min=43, s=54, tzH=4, tzMin=30},
    },
    [8] = {
      isoDate    = "2024-01-05T15:43:54-04:30",
      expDecDate = {y=2024, mo=1, d=5, h=15, min=43, s=54, tzH=-4, tzMin=30},
    },
  }

  for i, v in ipairs(validVariations) do
    local ok, decDate = pcall(decomposeIsoDate, v.isoDate) -- the decomposed date
    if not ok then -- `decDate` is `pcall`s error message here
      local decDateStr = tostring(decDate)
      local errMsg = decDateStr:match(":%d*: (.*)$") or decDateStr
      Log.errorEx(
        "Test %d failed. Expected yMd Hms tzHm: %s %s %s %s %s %s %s %s <> Got error: %s",
        i,
        tostring(v.expDecDate.y),   tostring(v.expDecDate.mo),  tostring(v.expDecDate.d),
        tostring(v.expDecDate.h),   tostring(v.expDecDate.min), tostring(v.expDecDate.s),
        tostring(v.expDecDate.tzH), tostring(v.expDecDate.tzMin),
        tostring(errMsg))
    elseif not decDate then
      Log.errorEx(
        "Test %d failed. Expected yMd Hms tzHm: %s %s %s %s %s %s %s %s <> Got: nil",
        i,
        tostring(v.expDecDate.y),   tostring(v.expDecDate.mo),  tostring(v.expDecDate.d),
        tostring(v.expDecDate.h),   tostring(v.expDecDate.min), tostring(v.expDecDate.s),
        tostring(v.expDecDate.tzH), tostring(v.expDecDate.tzMin))
    elseif (not decDate.year           or decDate.year           ~= v.expDecDate.y)   or
           (not decDate.month          or decDate.month          ~= v.expDecDate.mo)  or
           (not decDate.day            or decDate.day            ~= v.expDecDate.d)   or
           (not decDate.hour           or decDate.hour           ~= v.expDecDate.h)   or
           (not decDate.minute         or decDate.minute         ~= v.expDecDate.min) or
           (not decDate.second         or decDate.second         ~= v.expDecDate.s)   or
           (not decDate.timezoneHour   or decDate.timezoneHour   ~= v.expDecDate.tzH) or
           (not decDate.timezoneMinute or decDate.timezoneMinute ~= v.expDecDate.tzMin) then
      Log.errorEx(
        "Test %d failed. " ..
        "Expected yMd Hms tzHm: %s %s %s %s %s %s %s %s <> Got: %s %s %s %s %s %s %s %s",
        i,
        tostring(v.expDecDate.y),   tostring(v.expDecDate.mo),  tostring(v.expDecDate.d),
        tostring(v.expDecDate.h),   tostring(v.expDecDate.min), tostring(v.expDecDate.s),
        tostring(v.expDecDate.tzH), tostring(v.expDecDate.tzMin),
        tostring(decDate.year),         tostring(decDate.month),        tostring(decDate.day),
        tostring(decDate.hour),         tostring(decDate.minute),       tostring(decDate.second),
        tostring(decDate.timezoneHour), tostring(decDate.timezoneMinute))
    end
  end
end

local function test_HelperFunctions()
  test_decomposeIsoDate_InvalidIsoDateVariations_Errors()
  test_decomposeIsoDate_ValidIsoDateVariations_IsoDateParts()
end

--#endregion **********


--#region File functions **********

--- Constants defining which file hosts are allowed.
local AllowedFileHosts = {["VPOS"] = true, ["FILE"] = true, ["MEDIAFILE"] = false}

--- Checks for the existance of the file.
---@param fn string The file name/path to be checked
---@param host string? The file host; defaults to "VPOS" if `nil` and a host can't be extracted from `fn`
---@return boolean `true` if the file exists, otherwise `false` <br/>
---@see AllowedFileHosts
local function file_exists(fn, host)
  if not fn then return false end

  local i, j = string.find(fn, ":", 1, true)
  local fileHost
  if i then
    fileHost = fn:sub(1, j-1)
    fn = fn:gsub("VPOS:", "")
    fn = fn:gsub("FILE:", "")
  end

  host = host or fileHost or "VPOS"
  if not AllowedFileHosts[host] then return false end

  local files = vpos.file.getFileList(host)
  for _, name in pairs(files) do
    if fn == name then
      return true
    end
  end
  return false
end

--#endregion **********


--#region Logging functions **********

--- Creates a logger object.
---@param level string? The minimum log level for logging a line/message; defaults to `logLevel.Info` if `nil`
---@param logType string? The logging type/mode; defaults to `LogType.ONLINE` if `nil`
---@param logSize number? The max. log file size in kilobytes before rollover; defaults to 300 if `nil`
---@param url string? The Papertrail URL; defaults to `URL_PAPERTRAIL` if `nil`
---@param scriptName string? The name of the script which uses this logger; defaults to " " if `nil`
---@param scriptVersion string? The version of the script which uses this logger; defaults to "0" if `nil`
---@param scriptUpdate string? The last update date of the script which uses this logger; defaults to " " if `nil`
---@param vposName string? The name of the VPOS which uses this logger; defaults to "" if `nil`
---@return table self A new logger instance
function logger(level, logType, logSize, url, scriptName, scriptVersion, scriptUpdate, vposName)
  --- Logging level value associated to the logging level (name).
  local LogLevelValue = {
    UNKNOWN   = -1,
    OFF       = 0,
    RESERVED1 = 1,
    ERROR     = 2,
    WARN      = 3,
    RESERVED4 = 4,  -- reserved for "dev"/notice level
    INFO      = 5,
    DEBUG     = 6,
    TRACE     = 7,
  }

  --ATTENTION: keep this mapping function and all explicit log level usages in sync! 
  local function mapLogLevelNameToValue(levelName)
    if not levelName then                    return LogLevelValue.UNKNOWN
    elseif levelName == logLevel.Off then    return LogLevelValue.OFF
    elseif levelName == logLevel.Error then  return LogLevelValue.ERROR
    elseif levelName == logLevel.Warn then   return LogLevelValue.WARN
    elseif levelName == logLevel.Info then   return LogLevelValue.INFO
    elseif levelName == logLevel.Debug then  return LogLevelValue.DEBUG
    elseif levelName == logLevel.Trace then  return LogLevelValue.TRACE
    else                                     return LogLevelValue.UNKNOWN end
  end

  --- Maps the given logging level value to a Syslog Protocol priority.
  ---@param levelValue integer The logging level value
  ---@return integer # The Syslog Protocol priority
  --ATTENTION: keep this mapping function and all explicit priority usages in sync! 
  local function mapLogLevelValueToPriority(levelValue)
    if not levelValue then                         return Priority.USER_INFO
    elseif levelValue == LogLevelValue.ERROR then  return Priority.USER_ERROR
    elseif levelValue == LogLevelValue.WARN then   return Priority.USER_WARN
    elseif levelValue == LogLevelValue.INFO then   return Priority.USER_INFO
    elseif levelValue == LogLevelValue.DEBUG or
           levelValue == LogLevelValue.TRACE then  return Priority.USER_DEBUG
    else                                           return Priority.USER_INFO end
  end

  -- create a new instance
  local self = {
    message = ""
  }

  ---@private
  local logTab =  {
    levelValue    = mapLogLevelNameToValue(level or logLevel.Info),
    logType       = logType or LogType.ONLINE,
    logSize       = logSize or 300,
    url           = url or URL_PAPERTRAIL,
    scriptName    = scriptName or " ",
    scriptVersion = scriptVersion or "0",
    scriptUpdate  = scriptUpdate or " ",
    vposName      = vposName or ""
  }

  local function logData(message, full)
    message.datetime = dateISO()
    if not full then
      message.message = message.message:sub(1, LOG_TRUNCATE_SIZE)
    end

    -- add the message to queue
    vpos.script.callInterScriptFunctionExt("VPOS:logger.vsp", "ListPushLeft", {async = true}, message)
  end

  --- Logs information about the script.
  ---@param settings string? Additional script settings to be logged if non-`nil`
  function self.scriptInfo(settings)
    logTab.message      = string.format(
      "====== START ======== script:%s __ version:%s __ update:%s __ pv:%s __ serialNo:%s __ ip:%s",
      logTab.scriptName, logTab.scriptVersion, logTab.scriptUpdate,
      vpos.getSystemInfo(vpos.SystemInfo.SoftwareVersion),
      vpos.getSystemInfo(vpos.SystemInfo.Serial),
      vpos.getSystemInfo(vpos.SystemInfo.NetworkAddress))
    logTab.messageLevel = logLevel.Info
    logTab.priority     = Priority.USER_INFO
    logData(logTab)

    if settings then
      logTab.message = settings
      logData(logTab, true)
    end
  end

  --- Logs a trace message, containing the calling function line and name, the current Unix
  --- time and the given message, possibly truncating it.
  ---@param message string? The message to log
  ---@param full boolean? Flag to log the full message if `true`, otherwise the possibly truncated message
  function self.trace(message, full)
    if logTab.levelValue >= LogLevelValue.TRACE then
      local info = debug.getinfo(2, "nl")
      local msg  = message or ""
      if info then msg = string.format("<%d:%s> %s", info.currentline, info.name, msg) end
      local now = vpos.datetime.DateTime():getUnixTime() or ""
      logTab.message      = now .. "@ " .. msg
      logTab.messageLevel = logLevel.Trace
      logTab.priority     = Priority.USER_DEBUG
      logData(logTab, full)
    end
  end

  --- Logs a debug message, containing the calling function line and name and the given
  --- message, possibly truncating it.
  ---@param message string? The message to log
  ---@param full boolean? Flag to log the full message if `true`, otherwise the possibly truncated message
  function self.debug(message, full)
    if logTab.levelValue >= LogLevelValue.DEBUG then
      local info = debug.getinfo(2, "nl")
      local msg  = message or ""
      if info then msg = string.format("<%d:%s> %s", info.currentline, info.name, msg) end
      logTab.message      = msg
      logTab.messageLevel = logLevel.Debug
      logTab.priority     = Priority.USER_DEBUG
      logData(logTab, full)
    end
  end

  --- Logs an informational message, possibly truncating it.
  ---@param message string? The message to log
  ---@param full boolean? Flag to log the full message if `true`, otherwise the possibly truncated message
  function self.info(message, full)
    if logTab.levelValue >= LogLevelValue.INFO then
      logTab.message      = message or ""
      logTab.messageLevel = logLevel.Info
      logTab.priority     = Priority.USER_INFO
      logData(logTab, full)
    end
  end

  --- Logs a warning message, containing the calling function line and name and the given
  --- message, possibly truncating it.
  ---@param message string? The message to log
  ---@param full boolean? Flag to log the full message if `true`, otherwise the possibly truncated message
  function self.warn(message, full)
    if logTab.levelValue >= LogLevelValue.WARN then
      local info = debug.getinfo(2, "nl")
      local msg  = message or ""
      if info then msg = string.format("<%d:%s> %s", info.currentline, info.name, msg) end
      logTab.message      = msg
      logTab.messageLevel = logLevel.Warn
      logTab.priority     = Priority.USER_WARN
      logData(logTab, full)
    end
  end

  --- Logs an error message, containing the calling function line and name and the given
  --- message, always fully.
  ---@param message string? The message to log
  function self.error(message)
    if logTab.levelValue >= LogLevelValue.ERROR then
      local info = debug.getinfo(2, "nl")
      local msg  = message or ""
      if info then msg = string.format("<%d:%s> %s", info.currentline, info.name, msg) end
      logTab.message      = msg
      logTab.messageLevel = logLevel.Error
      logTab.priority     = Priority.USER_ERROR
      logData(logTab, true)
    end
  end

  --- Logs a message with the given logging level, containing the calling function line and
  --- name and a string formatted with the given format and vararg, possibly truncating the
  --- message.
  ---@param messageLevel logLevel The message logging level
  ---@param full boolean? Flag to log the full message if `true`, otherwise the possibly truncated message
  ---@param messageFormat string? The message format
  ---@param ... any The message vararg
  function self.log(messageLevel, full, messageFormat, ...)
    local messageLevelValue = mapLogLevelNameToValue(messageLevel)
    if messageLevelValue > LogLevelValue.OFF and logTab.levelValue >= messageLevelValue then
      local info = debug.getinfo(2, "nl")
      local msg  = (messageFormat and string.format(messageFormat, ...)) or ""
      if info then msg = string.format("<%d:%s> %s", info.currentline, info.name, msg) end
      if messageLevelValue == LogLevelValue.TRACE then
        local now = vpos.datetime.DateTime():getUnixTime() or ""
        msg = now .. "@ " .. msg
      end
      logTab.message      = msg
      logTab.messageLevel = messageLevel
      logTab.priority     = mapLogLevelValueToPriority(messageLevelValue)
      logData(logTab, full)
    end
  end

  return self
end

--#endregion **********


--#region Logging TESTS **********

local function test_QuickLogging()
  for k, v in pairs(debug.getinfo(1)) do
    Log.info(tostring(k) .. " -> " .. tostring(v))
  end
end

local function test_AllLoggingVariations()
  local msg100 = "123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789 123456789 "
  local msgGt1000 = "" -- length is 10 * (100+4) = 1040 greater than 1000
  for i = 0, 9 do
    msgGt1000 = string.format("%s[%d] %s", msgGt1000, i, msg100)
  end
  local msgLen = msgGt1000:len()
  assert(msgLen > LOG_TRUNCATE_SIZE)

  Log.trace(                     "Direct normal test without full:      " .. msgGt1000)
  Log.trace(                     "Direct normal test with full=false:   " .. msgGt1000, false)
  Log.trace(                     "Direct normal test with full=true:    " .. msgGt1000, true)
  Log.trace(                     "Direct normal test with full=0:       " .. msgGt1000, 0)
  Log.log(logLevel.Trace, nil,   "Indirect normal test with full=nil:   " .. msgGt1000)
  Log.log(logLevel.Trace, false, "Indirect normal test with full=false: " .. msgGt1000)
  Log.log(logLevel.Trace, true,  "Indirect normal test with full=true:  " .. msgGt1000)
  Log.log(logLevel.Trace, 0,     "Indirect normal test with full=0:     " .. msgGt1000)
  Log.trace(       string.format("Direct format test with full=false:   %s", msgGt1000), false)
  Log.trace(       string.format("Direct format test with full=true:    %s", msgGt1000), true)
  Log.log(logLevel.Trace, false, "Indirect format test with full=false: %s", msgGt1000)
  Log.log(logLevel.Trace, true,  "Indirect format test with full=true:  %s", msgGt1000)

  Log.debug(                     "Direct normal test without full:      " .. msgGt1000)
  Log.debug(                     "Direct normal test with full=false:   " .. msgGt1000, false)
  Log.debug(                     "Direct normal test with full=true:    " .. msgGt1000, true)
  Log.debug(                     "Direct normal test with full=0:       " .. msgGt1000, 0)
  Log.log(logLevel.Debug, nil,   "Indirect normal test with full=nil:   " .. msgGt1000)
  Log.log(logLevel.Debug, false, "Indirect normal test with full=false: " .. msgGt1000)
  Log.log(logLevel.Debug, true,  "Indirect normal test with full=true:  " .. msgGt1000)
  Log.log(logLevel.Debug, 0,     "Indirect normal test with full=0:     " .. msgGt1000)
  Log.debug(       string.format("Direct format test with full=false:   %s", msgGt1000), false)
  Log.debug(       string.format("Direct format test with full=true:    %s", msgGt1000), true)
  Log.log(logLevel.Debug, false, "Indirect format test with full=false: %s", msgGt1000)
  Log.log(logLevel.Debug, true,  "Indirect format test with full=true:  %s", msgGt1000)

  Log.info(                     "Direct normal test without full:      " .. msgGt1000)
  Log.info(                     "Direct normal test with full=false:   " .. msgGt1000, false)
  Log.info(                     "Direct normal test with full=true:    " .. msgGt1000, true)
  Log.info(                     "Direct normal test with full=0:       " .. msgGt1000, 0)
  Log.log(logLevel.Info, nil,   "Indirect normal test with full=nil:   " .. msgGt1000)
  Log.log(logLevel.Info, false, "Indirect normal test with full=false: " .. msgGt1000)
  Log.log(logLevel.Info, true,  "Indirect normal test with full=true:  " .. msgGt1000)
  Log.log(logLevel.Info, 0,     "Indirect normal test with full=0:     " .. msgGt1000)
  Log.info(       string.format("Direct format test with full=false:   %s", msgGt1000), false)
  Log.info(       string.format("Direct format test with full=true:    %s", msgGt1000), true)
  Log.log(logLevel.Info, false, "Indirect format test with full=false: %s", msgGt1000)
  Log.log(logLevel.Info, true,  "Indirect format test with full=true:  %s", msgGt1000)

  Log.warn(                     "Direct normal test without full:      " .. msgGt1000)
  Log.warn(                     "Direct normal test with full=false:   " .. msgGt1000, false)
  Log.warn(                     "Direct normal test with full=true:    " .. msgGt1000, true)
  Log.warn(                     "Direct normal test with full=0:       " .. msgGt1000, 0)
  Log.log(logLevel.Warn, nil,   "Indirect normal test with full=nil:   " .. msgGt1000)
  Log.log(logLevel.Warn, false, "Indirect normal test with full=false: " .. msgGt1000)
  Log.log(logLevel.Warn, true,  "Indirect normal test with full=true:  " .. msgGt1000)
  Log.log(logLevel.Warn, 0,     "Indirect normal test with full=0:     " .. msgGt1000)
  Log.warn(       string.format("Direct format test with full=false:   %s", msgGt1000), false)
  Log.warn(       string.format("Direct format test with full=true:    %s", msgGt1000), true)
  Log.log(logLevel.Warn, false, "Indirect format test with full=false: %s", msgGt1000)
  Log.log(logLevel.Warn, true,  "Indirect format test with full=true:  %s", msgGt1000)

  Log.error(                     "Direct normal test:                   " .. msgGt1000)
  Log.log(logLevel.Error, nil,   "Indirect normal test with full=nil:   " .. msgGt1000)
  Log.log(logLevel.Error, false, "Indirect normal test with full=false: " .. msgGt1000)
  Log.log(logLevel.Error, true,  "Indirect normal test with full=true:  " .. msgGt1000)
  Log.log(logLevel.Error, 0,     "Indirect normal test with full=0:     " .. msgGt1000)
  Log.error(       string.format("Direct format test:                   %s", msgGt1000))
  Log.log(logLevel.Error, false, "Indirect format test with full=false: %s", msgGt1000)
  Log.log(logLevel.Error, true,  "Indirect format test with full=true:  %s", msgGt1000)
end

function test_LoggingFromGlobalFun()
  Log.info(                      "Direct normal test from global function")
  Log.error(                     "Direct normal test from global function")
  Log.log(logLevel.Info,  false, "Indirect normal test from global function")
  Log.log(logLevel.Error, false, "Indirect normal test from global function")
end

local function test_LoggingFromLocalFun()
  Log.info(                      "Direct normal test from local function")
  Log.error(                     "Direct normal test from local function")
  Log.log(logLevel.Info,  false, "Indirect normal test from local function")
  Log.log(logLevel.Error, false, "Indirect normal test from local function")
end

local function IndirectTestWithPercentageChar()
  Log.log(logLevel.Info, false,                  "Indirect test with percentage char %c without vararg")
end
local function test_LogMessageWithPercentageCharButWithoutVararg()
  local ok, err
  local errMsg = "bad argument #2 to 'format' (no value)"

  ok, err = pcall(Log.info,                      "Direct test with percentage char %c without vararg")
  if not ok then
    Log.error(string.format("Expected: true nil <> Got: %s '%s'", tostring(ok), tostring(err)))
  end

  ok, err = pcall(Log.log, logLevel.Info, false, "Indirect test with percentage char %c without vararg")
  if ok then
    Log.error(string.format("Expected: false '%s' <> Got: %s %s",
      errMsg, tostring(ok), tostring(err)))
  elseif type(err) ~= "string" or err:match(":%d+: (.*)$") ~= errMsg then
    Log.warn(string.format("Expected error: %s <> Got: %s", errMsg, tostring(err)))
  end
  ok, err = pcall(IndirectTestWithPercentageChar)
  if ok then
    Log.error(string.format("Expected: false '%s' <> Got: %s %s",
      errMsg, tostring(ok), tostring(err)))
  elseif type(err) ~= "string" or err:match(":%d+: (.*)$") ~= errMsg then
    Log.warn(string.format("Expected error: %s <> Got: %s", errMsg, tostring(err)))
  end
end

local function test_LoggingFunctions()
  test_QuickLogging()
  test_AllLoggingVariations()

  test_LoggingFromGlobalFun()
  test_LoggingFromLocalFun()

  test_LogMessageWithPercentageCharButWithoutVararg()
end

--#endregion **********


--#region Initialization functions **********

local function readIni()
  local initTab = vpos.utils.readIniFromFile("VPOS:logger_ut.ini")
  if initTab and type(initTab) == "table" and
     initTab.LOGS and type(initTab.LOGS) == "table" then
    LOG_LEVEL         = (initTab.LOGS.LOG_LEVEL         and string.lower(tostring(initTab.LOGS.LOG_LEVEL))) or LOG_LEVEL
    LOG_TYPE          = (initTab.LOGS.LOG_TYPE          and string.lower(tostring(initTab.LOGS.LOG_TYPE)))  or LOG_TYPE
    LOG_SIZE          = (initTab.LOGS.LOG_SIZE          and tonumber(initTab.LOGS.LOG_SIZE))                or LOG_SIZE
    LOG_TRUNCATE_SIZE = (initTab.LOGS.LOG_TRUNCATE_SIZE and tonumber(initTab.LOGS.LOG_TRUNCATE_SIZE))       or LOG_TRUNCATE_SIZE
    URL_PAPERTRAIL    = (initTab.LOGS.URL_PAPERTRAIL    and tostring(initTab.LOGS.URL_PAPERTRAIL))          or URL_PAPERTRAIL
  end

  local scriptName    = vpos.script.currentScript():getName() or ""
  local scriptVersion = tostring(vpos.tables.Table(806):getData(scriptName, 15) or 0)
  local posName       = tostring(vpos.getSystemInfo(vpos.SystemInfo.ECRId):gsub(" ", ""))
  local update        = vpos.tables.Table(806):getData(scriptName, 6)
  local scriptUpdate  = (type(update) == "vec.types.Time" and tostring(update)) or "plsUpdate VPOS"

  if LOG_LEVEL == logLevel.Off then
    -- create a mock "object" with no functionality
    Log = {
      ["scriptInfo"]           = function() end,
      [logLevel.Trace]         = function() end,
      [logLevel.Debug]         = function() end,
      [logLevel.Info]          = function() end,
      [logLevel.Warn]          = function() end,
      [logLevel.Error]         = function() end,
      ["log"]                  = function() end,
    }
  else
    if not file_exists("logger.vsp") then
      vpos.view.showWindow("Log settings wrong!\001Please set LOG_LEVEL = off or import the logger script!")
      vpos.script.exitScript()
    end
    Log = logger(LOG_LEVEL, LOG_TYPE, LOG_SIZE, URL_PAPERTRAIL, scriptName,
                 scriptVersion, scriptUpdate, posName)
  end

  Log.scriptInfo(vpos.utils.encodeJSON(initTab or {}))
end

--#endregion **********


--#region MAIN **********

readIni()

-- testing the logging should be first, for the other tests to correctly report results
test_LoggingFunctions()
test_HelperFunctions()

--#endregion **********