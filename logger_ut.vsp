--#region Script constants and enums **********

--- Logging level.
local logLevel = {
  Off   = "off",
  Error = "error",
  Warn  = "warn",
  Info  = "info",
  Debug = "debug",
  Trace = "trace",
}

--- Syslog Protocol priority (RFC-5424).
local Priority = {
  USER_ERROR = 11,
  USER_WARN  = 12,
  USER_INFO  = 14,
  USER_DEBUG = 15,
}

--- Logging type/mode.
local LogType = {
  OFFLINE = "offline",
  ONLINE  = "online",
}

--- Minimum log level for logging a line/message.
LOG_LEVEL = logLevel.Info

--- Switch to online or offline/local logs.
LOG_TYPE = LogType.OFFLINE

--- Maximum log file size in kilobytes before rollover.
LOG_SIZE = 300

--- Maximum log line/message size in bytes after which is it truncated, if not doing
--- a full send; truncation is the default behavior.
LOG_TRUNCATE_SIZE = 1000

--- URL where logs are shown on Papertrail.
URL_PAPERTRAIL = "http://logs6.papertrailapp.com:17732"

--- ISO 8601 date constants.
local IsoDate = {
  DATE_SEP_BYTE      = string.byte("-", 1), --- Separator between date parts.
  TIME_MARK_BYTE     = string.byte("T", 1), --- Time mark/sign between the date and time sections.
  TIME_SEP_BYTE      = string.byte(":", 1), --- Separator between the time parts and respectively time zone parts.
  TZ_UTC_MARK_BYTE   = string.byte("Z", 1), --- Time zone UTC mark/sign.
  TZ_PLUS_MARK_BYTE  = string.byte("+", 1), --- Time zone plus mark/sign.
  TZ_MINUS_MARK_BYTE = string.byte("-", 1), --- Time zone minus mark/sign.
}

--#endregion **********


--#region Script variables **********

--- The logger object.
Log = {}

--#endregion **********


--#region Helper functions **********

local fmt = string.format

assertAndOrLog = function(condition, errMsg) assert(condition, errMsg) end

--- Extracts and returns the error reason from the given error message of a
--- raised error. On extraction failure, returns the given error message.
---@param errMsg string #The error message of a raised error
---@return string #The extracted error reason on success, otherwise the given error message
local function getErrorReason(errMsg)
  return errMsg:match(":%d+: (.*)$") or errMsg
end

--- Formats the given or current date according to the ISO 8601 long format
--- `yyyy-mm-ddThh:mm:ss.ffff[+-]hh:mm`.<br/>
--- Example of returned date: `2016-11-09T04:25:28.0000+02:00`.
---@param date table? #A `vpos.datetime.DateTime` object to be formatted; defaults to the current date if `nil`
---@return string #The formatted given or current date
local function dateISO(date)
  date = date or vpos.datetime.DateTime()
  local day, month, year = date:getDate()
  local hour, minute, second = date:getTime()

  -- determine the hour offset corresponding to DST (daylight saving time) Europe:
  local offset = 0
  -- January, February, November and December are out
  if     month > 3 and month < 10 then -- April to September are in
    offset = 1
  elseif month == 3 then -- March
    local marchSunday = math.ceil(31 - ((1.25 * year + 4) % 7))
    -- in March we are DST if our day is the last Sunday (can be the 25th ~ 31st) or after
    if day >= marchSunday then offset = 1 end
  elseif month == 10 then -- October
    local octoberSunday = math.ceil(31 - ((1.25 * year + 1) % 7))
    -- in October we are DST if our day is before the last Sunday (can be the 25th ~ 31st)
    if day < octoberSunday then offset = 1 end
  end

  return fmt("%s-%02d-%02dT%02d:%02d:%02d.0000+%02d:00",
             tostring(year), month, day, hour, minute, second, 2 + offset)
end

--- Decomposes the given date in ISO 8601 long format `yyyy-mm-ddThh:mm:ss.(f+)[+-]hh:mm`
--- (length min. 27 max. 32).<br/>
--- NOTE: Accepted formats are also `yyyy-mm-ddThh:mm:ss.(f+)Z` (UTC length min. 22 max. 27)
--- and `yyyy-mm-ddThh:mm:ss.(f+)[+-]hh` (length min. 24 max. 29). Notice that the fractional
--- second must have between 1 and 6 digits.
--- 
--- RAISES an error if the string is not an ISO 8601 date.
---@param isoDate string #The date in ISO 8601 format
---@return table #A table with all of the ISO date parts:
---   * `year`, `month`, `day` integer
---   * `hour`, `minute`, `second`, `fracSecond` integer
---   * `timezoneHour`, `timezoneMinute` integer 
local function decomposeIsoDate(isoDate)
  assertAndOrLog(isoDate)

  -- ISO 8601: y y y y - m m - d d T h h : m m : s s . f+ [+-Z] h h :    m m
  -- Position: 1       5     8     11    14    17    20   21+F      24+F   26+F
  -- where F = digit count of fractional second in range [1, 6]

  local dateLen = isoDate:len()
  if     dateLen < 22 then
    error("String is too short for an ISO 8601 date or is incomplete (till fractional second required)")
  elseif dateLen > 32 then
    error("String is too long for an ISO 8601 date")
  end

  local y, mo, d, h, min, s, f, tzmk, tzh, tzmin = isoDate:match(
    "^(%d%d%d%d)%-(%d%d)%-(%d%d)T(%d%d):(%d%d):(%d%d)%.(%d+)([+%-Z])(%d*)(:?%d*)$")

  if tzh and tzh:len() == 0 then tzh = nil end
  if tzmin then
    local tzminLen = tzmin:len()
    if     tzminLen == 0 then tzmin = nil
    elseif tzminLen == 1 then error("String is not an ISO 8601 date")
    else                      tzmin = tzmin:sub(2) end
  end

  if not y or not mo or not d or not h or not min or not s or not f or not tzmk or
     (tzmk == "Z" and (tzh or tzmin)) or (tzmk ~= "Z" and not tzh) then
    error("String is not an ISO 8601 date")
  end

  if           f:len()     >  6 then error("Fractional second contains too many digits") end
  if tzh   and tzh:len()   ~= 2 then error("Time zone hour doesn't contain 2 digits") end
  if tzmin and tzmin:len() ~= 2 then error("Time zone minute doesn't contain 2 digits") end

  local year  = tonumber(y)
  local month = tonumber(mo)
  local day   = tonumber(d)
  assertAndOrLog(year and month and day)

  local hour        = tonumber(h)
  local minute      = tonumber(min)
  local second      = tonumber(s)
  local fracSecond  = tonumber("0." .. f)
  assertAndOrLog(hour and minute and second and fracSecond)

  local timezoneHour    = tonumber((tzh   and tzmk .. tzh)   or 0)
  local timezoneMinute  = tonumber((tzmin and tzmk .. tzmin) or 0)
  assertAndOrLog(timezoneHour and timezoneMinute)

  return {
    year = year, month = month, day = day,
    hour = hour, minute = minute, second = second, fracSecond = fracSecond,
    timezoneHour = timezoneHour, timezoneMinute = timezoneMinute,
  }
end

