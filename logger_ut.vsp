local function test_decomposeIsoDate_InvalidIsoDateVariations_Errors()
  local invalidVariations = {
    [1] = {
      isoDate   = "",
      expErrMsg = "String is too short for an ISO 8601 date or is incomplete (till fractional second required)",
    },
    [2] = {
      isoDate   = "bla bla",
      expErrMsg = "String is too short for an ISO 8601 date or is incomplete (till fractional second required)",
    },
    [3] = {
      isoDate   = "2024-01-02T12:40",
      expErrMsg = "String is too short for an ISO 8601 date or is incomplete (till fractional second required)",
    },
    [4] = {
      isoDate   = "2024-01-03T13:41:52.1234567+01:00",
      expErrMsg = "String is too long for an ISO 8601 date",
    },
    [5] = {
      isoDate   = "2024-01-03T13:41:52.1234567Z",
      expErrMsg = "Fractional second contains too many digits",
    },
    [6] = {
      isoDate   = "2024-01-04T14:41:52.0+",
      expErrMsg = "String is not an ISO 8601 date",
    },
    [7] = {
      isoDate   = "2024-01-04T14:41:52.0+2",
      expErrMsg = "Time zone hour doesn't contain 2 digits",
    },
    [8] = {
